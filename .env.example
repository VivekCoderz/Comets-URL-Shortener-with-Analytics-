# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it contains secrets.

# MongoDB Atlas → Database → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/comets-url-shortener

# Upstash console → your Redis database → REST API section
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# The address short links are built on (local dev: http://localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Signs the login cookie (JWT). Any long random string, at least 32 characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=<long-random-string>

# Shared secret the scheduler sends to POST /api/cron/flush-clicks
# (header: Authorization: Bearer <CRON_SECRET>). At least 16 characters.
CRON_SECRET=<long-random-string>

# Salt for the visitor hash used in click analytics. Any long random string, at least 32 characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VISITOR_HASH_SALT=<long-random-string>
